{
    "manifest_version": 3,
    "name": "KanbanFlow-Zeitexport",
    "version": "0.2.0",
    "description": "Exportiert die in KanbanFlow erfassten Zeiten eines Tages und trägt sie in Personio ein.",
    "permissions": ["storage"],
    "web_accessible_resources": [
        {
            "resources": ["assets/logos/*"],
            "matches": ["https://kanbanflow.com/*", "https://mahredv.app.personio.com/*"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["https://kanbanflow.com/board/*"],
            "js": [
                "src/kanbanflow/zeitabschnitte.js",
                "src/kanbanflow/zeitstrahl.js",
                "src/personio/umrechnung.js",
                "src/vorschau.js",
                "src/kanbanflow/content-kanbanflow.js"
            ],
            "css": ["src/kanbanflow/content-kanbanflow.css"]
        },
        {
            "matches": ["https://mahredv.app.personio.com/*"],
            "js": [
                "src/personio/tagauswahl.js",
                "src/personio/content-personio.js"
            ],
            "css": ["src/kanbanflow/content-kanbanflow.css"]
        }
    ]
}
