{
    "manifest_version": 3,
    "name": "KanbanFlow-Zeitexport",
    "version": "0.1.0",
    "description": "Exportiert die in KanbanFlow erfassten Zeiten eines Tages.",
    "content_scripts": [
        {
            "matches": ["https://kanbanflow.com/board/*"],
            "js": ["src/kanbanflow/zeitabschnitte.js", "src/kanbanflow/zeitstrahl.js", "src/kanbanflow/content-kanbanflow.js"],
            "css": ["src/kanbanflow/content-kanbanflow.css"]
        }
    ]
}
